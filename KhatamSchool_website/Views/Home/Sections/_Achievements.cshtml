<section class="achievements-section">
    <div class="container">
        <div class="section-header text-center">
            <span class="section-badge">
                <i class="fa-solid fa-trophy"></i>
                افتخارات مدرسه
            </span>
            <h2 class="section-title">
                دستاوردهای دبستان <span class="highlight">خاتم</span>
            </h2>
            <p class="section-description">
                بخشی از موفقیت‌ها و افتخارات دانش‌آموزان و مجموعه آموزشی خاتم
            </p>
        </div>
        <div class="row g-4 mt-5">
            <div class="col-lg-4">
                <a asp-controller="Home" asp-action="Achievements" asp-route-CategoryId="1"
                   class="achievement-card text-decoration-none">
                    <div class="achievement-icon">
                        <i class="fa-solid fa-trophy"></i>
                    </div>
                    <h4>افتخارات فرهنگی</h4>
                    <p>حضور فعال در مسابقات فرهنگی و هنری</p>
                    <span class="achievement-link">
                        مشاهده جزئیات <i class="fa-solid fa-arrow-left"></i>
                    </span>
                </a>
            </div>
            <div class="col-lg-4">
                <a asp-controller="Home" asp-action="Achievements" asp-route-CategoryId="2"
                   class="achievement-card text-decoration-none">
                    <div class="achievement-icon">
                        <i class="fa-solid fa-medal"></i>
                    </div>
                    <h4>رتبه‌های علمی</h4>
                    <p>موفقیت دانش‌آموزان در مسابقات و جشنواره‌های علمی</p>
                    <span class="achievement-link">
                        مشاهده جزئیات <i class="fa-solid fa-arrow-left"></i>
                    </span>
                </a>
            </div>
            <div class="col-lg-4">
                <a asp-controller="Home" asp-action="Achievements" asp-route-CategoryId="3"
                   class="achievement-card text-decoration-none">
                    <div class="achievement-icon">
                        <i class="fa-solid fa-star"></i>
                    </div>
                    <h4>مهارت‌های فردی</h4>
                    <p>پرورش خلاقیت و توانمندی‌های فردی دانش‌آموزان</p>
                    <span class="achievement-link">
                        مشاهده جزئیات <i class="fa-solid fa-arrow-left"></i>
                    </span>
                </a>
            </div>
        </div>
    </div>
</section>