<section class="hero-section">
    <div class="blob hero-blob-1"></div>
    <div class="blob hero-blob-2"></div>
    <div class="hero-grid-pattern"></div>
    <div class="hero-overlay"></div>
    <div class="container">
        <div class="row align-items-center min-vh-100">
            <div class="col-lg-6">
                <div class="hero-content">
                    <span class="hero-badge">
                        <i class="fa-solid fa-sparkles"></i>
                        پیش دبستان و دبستان غیردولتی پسرانه خاتم
                    </span>
                    <h1 class="hero-title">
                        آینده از اینجا
                        <span class="highlight">آغاز می‌شود</span>
                    </h1>
                    <p class="hero-description">
                        محیطی پویا برای پرورش
                        خلاقیت، مسئولیت‌پذیری
                        و یادگیری نسل آینده
                    </p>
                    <div class="hero-buttons">
                        <a href="#registration-cta" class="btn hero-primary-btn">
                            ثبت نام آنلاین
                            <i class="fa-solid fa-arrow-left"></i>
                        </a>
                        <a href="#departments" class="btn hero-secondary-btn">
                            آشنایی با مدرسه
                        </a>
                    </div>
                    <div class="hero-mini-stats">
                        <div class="mini-stat">
                            <strong>+35</strong>
                            <span>سال تجربه</span>
                        </div>
                        <div class="mini-stat-divider"></div>
                        <div class="mini-stat">
                            <strong>+200</strong>
                            <span>دانش‌آموز</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="hero-image-wrapper">
                    <div class="hero-image-glow"></div>
                    <div class="hero-image-frame">
                        <img src="~/Images/Hero/۲۰۲۶۰۶۳۰_۰۹۱۲۴۶.webp"
                             alt="مدرسه خاتم"
                             class="img-fluid hero-image"
                             fetchpriority="high"
                             decoding="async"
                             width="4000"
                             height="2252">
                    </div>
                    <div class="hero-float-card hero-float-card-1">
                        <i class="fa-solid fa-graduation-cap"></i>
                        <span>آموزش نوین</span>
                    </div>
                    <div class="hero-float-card hero-float-card-2">
                        <i class="fa-solid fa-shield-heart"></i>
                        <span>محیطی شاد و امن</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
