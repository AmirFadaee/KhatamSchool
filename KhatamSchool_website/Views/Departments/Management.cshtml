@{
    ViewData["Title"] = "کادر مدیریتی";
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/Departments/management.css" />
}

<section class="management-hero">
    <div class="management-hero-bg"></div>
    <div class="floating-orb orb-1"></div>
    <div class="floating-orb orb-2"></div>
    <div class="container text-center">
        <div class="management-hero-content">
            <span class="team-badge" data-aos="fade-down">کادر اجرایی</span>
            <h1 data-aos="fade-up" data-aos-delay="100">تیم مدیریت و اجرایی مدرسه</h1>
            <p data-aos="fade-up" data-aos-delay="200">رهبرانی که مسیر آموزش را هموار می‌کنند</p>
        </div>
    </div>
</section>

<section class="executive-grid">
    <div class="container">
        <div class="row g-5 align-items-start">
            <div class="col-lg-4" data-aos="fade-right" data-aos-delay="100">
                <div class="executive-card principal"
                     data-name="سرکار خانم واحدیان"
                     data-role="مدیر پیش دبستان و دبستان غیر دولتی پسرانه خاتم"
                     data-desc="مدیریت توانمند و مجرب با مدرک دکتری"
                     data-exp="36+"
                     data-field="مدیریت آموزشی"
                     data-img="/images/Management/file_00000000a2d071f799dcfd664a21c111.webp">
                    <div class="principal-glow"></div>
                    <div class="principal-badge">مدیریت</div>
                    <div class="principal-img-wrapper">
                        <img src="~/images/Management/file_00000000a2d071f799dcfd664a21c111.webp" alt="مدیر مدرسه" />
                        <div class="principal-img-ring"></div>
                    </div>
                    <div class="principal-info">
                        <h3>سرکار خانم واحدیان</h3>
                        <span class="principal-title">مدیر پیش دبستان و دبستان غیر دولتی پسرانه خاتم</span>
                        <p>مدیریت توانمند و مجرب با مدرک دکتری</p>
                        <div class="principal-stats">
                            <div class="stat">
                                <strong>36+</strong>
                                <span>سال تجربه</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="row g-4">

@*                     <img src="~/images/Management/ChatGPT Image ۲۹ تیر ۱۴۰۵، ۱۲_۰۶_۴۰.png" alt="مدیر مدرسه" /> *@

                    <!-- معاون ۱ -->
                    <div class="col-md-6" data-aos="fade-up" data-aos-delay="80">
                        <div class="executive-card staff-card"
                             data-name="آقای اسداله قاسمی"
                             data-role="معاون آموزشی"
                             data-desc="با بیش از 30 سال سابقه ی آموزش با مدرک کارشناسی ارشد"
                             data-exp="30+"
                             data-field="آموزشی"
                             data-img="/images/Management/file_00000000763471f49975f770a14f4521.webp">
                            <div class="staff-card-icon">
                                <div class="icon-ring"></div>
                                <span>1</span>
                            </div>
                            <div class="staff-card-body">
                                <h4>آقای اسداله قاسمی</h4>
                                <p>معاون آموزشی</p>
                            </div>
                            <div class="staff-card-shine"></div>
                        </div>
                    </div>

                    <!-- معاون ۲ -->
                    <div class="col-md-6" data-aos="fade-up" data-aos-delay="120">
                        <div class="executive-card staff-card"
                             data-name="آقای علی غلامی"
                             data-role="معاون انضباطی"
                             data-desc="با بیش از 15 سال سابقه ی آموزش با مدرک کارشناسی"
                             data-exp="15+"
                             data-field="انضباطی"
                             data-img="/images/Management/ChatGPT Image ۲۷ تیر ۱۴۰۵، ۲۲_۵۹_۵۳.webp">
                            <div class="staff-card-icon">
                                <div class="icon-ring"></div>
                                <span>2</span>
                            </div>
                            <div class="staff-card-body">
                                <h4>آقای علی غلامی</h4>
                                <p>معاون انضباطی</p>
                            </div>
                            <div class="staff-card-shine"></div>
                        </div>
                    </div>

                    <!-- معاون ۳ -->
                    <div class="col-md-6" data-aos="fade-up" data-aos-delay="160">
                        <div class="executive-card staff-card"
                             data-name="خانم حنانه بخشنده"
                             data-role="معاون مالی"
                             data-desc="با بیش از 20 سال سابقه با مدرک کارشناسی"
                             data-exp="20+"
                             data-field="امور مالی"
                             data-img="/images/Management/ChatGPT Image ۲۷ تیر ۱۴۰۵، ۲۳_۱۴_۵۱.webp">
                            <div class="staff-card-icon">
                                <div class="icon-ring"></div>
                                <span>3</span>
                            </div>
                            <div class="staff-card-body">
                                <h4>خانم حنانه بخشنده</h4>
                                <p>معاون مالی</p>
                            </div>
                            <div class="staff-card-shine"></div>
                        </div>
                    </div>

                    <!-- معاون ۴ -->
                    <div class="col-md-6" data-aos="fade-up" data-aos-delay="200">
                        <div class="executive-card staff-card"
                             data-name="خانم بنفشه میرزاوند"
                             data-role="معاون پرورشی"
                             data-desc="با بیش از 14 سال سابقه با مدرک کارشناسی"
                             data-exp="14+"
                             data-field="پرورشی"
                             data-img="/images/Management/b47861e3008dcd24db363c28936d628bde684c3dbd84b818f5d54a8c236c2430.webp">
                            <div class="staff-card-icon">
                                <div class="icon-ring"></div>
                                <span>4</span>
                            </div>
                            <div class="staff-card-body">
                                <h4>خانم بنفشه میرزاوند</h4>
                                <p>معاون پرورشی</p>
                            </div>
                            <div class="staff-card-shine"></div>
                        </div>
                    </div>

                    <!-- معاون ۵ -->
                    <div class="col-md-6" data-aos="fade-up" data-aos-delay="280">
                        <div class="executive-card staff-card"
                             data-name="خانم سمانه زیرک"
                             data-role="معاون اجرایی"
                             data-desc="با بیش از 14 سال سابقه با مدرک کارشناسی ارشد"
                             data-exp="14+"
                             data-field="اجرایی"
                             data-img="/images/Management/ChatGPT Image ۲۹ تیر ۱۴۰۵، ۱۲_۰۰_۳۵.webp">
                            <div class="staff-card-icon">
                                <div class="icon-ring"></div>
                                <span>5</span>
                            </div>
                            <div class="staff-card-body">
                                <h4>خانم سمانه زیرک</h4>
                                <p>معاون اجرایی</p>
                            </div>
                            <div class="staff-card-shine"></div>
                        </div>
                    </div>

                    <!-- معاون ۶ -->
                    <div class="col-md-6" data-aos="fade-up" data-aos-delay="240">
                        <div class="executive-card staff-card"
                             data-name="آقای سید آرمین حقیقی"
                             data-role="روابط عمومی"
                             data-desc="با بیش از 13 سال سابقه با مدرک کارشناسی ارشد"
                             data-exp="13+"
                             data-field="روابط عمومی"
                             data-img="/images/Management/۲۷ تیر ۱۴۰۵، ۲۲_۴۸_۳۰.webp">
                            <div class="staff-card-icon">
                                <div class="icon-ring"></div>
                                <span>6</span>
                            </div>
                            <div class="staff-card-body">
                                <h4>آقای سید آرمین حقیقی</h4>
                                <p>روابط عمومی</p>
                            </div>
                            <div class="staff-card-shine"></div>
                        </div>
                    </div>

                    <!-- معاون ۷ -->
                    <div class="col-md-6" data-aos="fade-up" data-aos-delay="240">
                        <div class="executive-card staff-card"
                             data-name="آقای مهدی صداقتی نیا"
                             data-role="معاون انضباطی"
                             data-desc="با بیش از 5 سال سابقه با مدرک کارشناسی"
                             data-exp="5+"
                             data-field="انضباطی"
                             data-img="/images/Management/ChatGPT Image ۲۹ تیر ۱۴۰۵، ۱۲_۰۶_۴۰.webp">
                            <div class="staff-card-icon">
                                <div class="icon-ring"></div>
                                <span>7</span>
                            </div>
                            <div class="staff-card-body">
                                <h4>آقای مهدی صداقتی نیا</h4>
                                <p>معاون انضباطی</p>
                            </div>
                            <div class="staff-card-shine"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="management-modal">
    <div class="management-backdrop"></div>
    <div class="management-modal-content">
        <button class="management-close-modal">×</button>
        <div class="modal-left">
            <div class="modal-img-wrapper">
                <img id="modalImg" src="" alt="" />
                <div class="modal-img-ring"></div>
            </div>
            <div class="modal-badge-wrapper">
                <span id="modalBadge" class="modal-role-badge"></span>
            </div>
        </div>
        <div class="modal-right">
            <h2 id="modalName"></h2>
            <p id="modalDesc"></p>
            <div class="modal-stats">
                <div class="modal-stat">
                    <strong id="modalExp"></strong>
                    <span>سال تجربه</span>
                </div>
                <div class="modal-stat-divider"></div>
                <div class="modal-stat">
                    <strong id="modalField"></strong>
                    <span>حوزه تخصصی</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Departments/management.js"></script>
}