@{
    ViewData["Title"] = "بخش زبان";
}

@section Styles {

    <link rel="stylesheet"
          href="~/css/Departments/language.css" />

}

<section class="lang-hero">
    <div class="lang-hero-bg"></div>
    <canvas id="langParticles"></canvas>
    <div class="container text-center">
        <div class="lang-hero-content">
            <span class="lang-badge" data-aos="fade-down">Language Department</span>
            <h1 data-aos="fade-up" data-aos-delay="100">بخش آموزش زبان</h1>
            <p data-aos="fade-up" data-aos-delay="200">یادگیری زبان، پنجره‌ای به دنیای بی‌انتها</p>
            <div class="lang-hero-stats" data-aos="fade-up" data-aos-delay="300">
                <div class="lang-stat">
                    <strong>4</strong>
                    <span>استاد متخصص</span>
                </div>
                <div class="lang-stat-divider"></div>
                <div class="lang-stat">
                    <strong>انگلیسی</strong>
                    <span>زبان تدریسی</span>
                </div>
                <div class="lang-stat-divider"></div>
                <div class="lang-stat">
                    <strong>200+</strong>
                    <span>دانش‌آموز فعال</span>
                </div>
            </div>
        </div>
    </div>
    <div class="lang-scroll-hint">
        <div class="scroll-line"></div>
    </div>
</section>

<section class="lang-services">
    <div class="container">
        <div class="section-header" data-aos="fade-up">
            <span class="section-tag">مهارت‌های آموزشی</span>
            <h2>مسیر جامع یادگیری زبان انگلیسی</h2>
        </div>

        <div class="services-grid">

            <div class="service-card" data-aos="fade-up" data-aos-delay="100">
                <div class="service-icon">🎧</div>
                <h3>مهارت شنیداری (Listening)</h3>
                <p>تقویت درک مکالمات واقعی، فایل‌های صوتی و لهجه‌های استاندارد انگلیسی.</p>

                <div class="service-level">
                    <span>تمام سطوح</span>
                    <div class="level-bar">
                        <div class="level-fill" style="width:100%"></div>
                    </div>
                </div>
            </div>

            <div class="service-card" data-aos="fade-up" data-aos-delay="200">
                <div class="service-icon">🗣️</div>
                <h3>مهارت گفتاری (Speaking)</h3>
                <p>افزایش اعتمادبه‌نفس در مکالمه، تلفظ صحیح و برقراری ارتباط روان.</p>

                <div class="service-level">
                    <span>تمام سطوح</span>
                    <div class="level-bar">
                        <div class="level-fill" style="width:100%"></div>
                    </div>
                </div>
            </div>

            <div class="service-card" data-aos="fade-up" data-aos-delay="300">
                <div class="service-icon">📖</div>
                <h3>مهارت خواندن (Reading)</h3>
                <p>درک متون آموزشی، داستان‌ها و مقالات با افزایش دایره واژگان.</p>

                <div class="service-level">
                    <span>تمام سطوح</span>
                    <div class="level-bar">
                        <div class="level-fill" style="width:100%"></div>
                    </div>
                </div>
            </div>

            <div class="service-card" data-aos="fade-up" data-aos-delay="400">
                <div class="service-icon">✍️</div>
                <h3>مهارت نوشتاری (Writing)</h3>
                <p>یادگیری نگارش صحیح جملات، متن‌ها و تقویت مهارت‌های نوشتاری.</p>

                <div class="service-level">
                    <span>تمام سطوح</span>
                    <div class="level-bar">
                        <div class="level-fill" style="width:100%"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<section class="lang-teachers">
    <div class="container">

        <div class="section-header" data-aos="fade-up">
            <span class="section-tag">تیم ما</span>
            <h2>اساتید بخش زبان</h2>
        </div>

        <!-- Supervisor -->
        <div class="row justify-content-center mb-5">

            <div class="col-xl-5 col-lg-6 col-md-8"
                 data-aos="zoom-in">

                <div class="lang-teacher-card supervisor-card"
                     data-name="خانم زهره عزیزی"
                     data-role="سوپروایزر بخش زبان انگلیسی"
                     data-desc="بیش از 22 سال سابقه ی کار ,با مدرک کارشناسی ارشد در رشته مترجمی زبان انگلیسی"
                     data-exp="22+"
                     data-lang="English Department"
                     data-img="/images/Language/4b11b79a346b8628f990e4c2cea594ffab5a155b36e8fd809b8f0d25e3ab4030.webp">

                    <div class="lang-card-glow"></div>

                    <div class="lang-card-top">

                        <div class="lang-teacher-img">
                            <img src="~/images/Language/4b11b79a346b8628f990e4c2cea594ffab5a155b36e8fd809b8f0d25e3ab4030.webp" alt="سوپروایزر" />
                            <div class="lang-img-ring"></div>
                        </div>

                        <div class="lang-teacher-flag">
                            👑
                        </div>

                    </div>

                    <div class="lang-card-body">

                        <h4>خانم زهره عزیزی</h4>

                        <span>سوپروایزر بخش زبان انگلیسی</span>

                        <button class="lang-profile-btn">
                            مشاهده پروفایل
                        </button>

                    </div>

                </div>

            </div>

        </div>


