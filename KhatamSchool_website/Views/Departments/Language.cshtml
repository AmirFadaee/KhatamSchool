<div class="lang-modal">
    <div class="lang-backdrop"></div>
    <div class="lang-modal-content">
        <button class="lang-close-modal">×</button>
        <div class="lmodal-left">
            <div class="lmodal-img-wrapper">
                <img id="lModalImg" src="" alt="" />
                <div class="lmodal-img-ring"></div>
            </div>
            <span id="lModalBadge" class="lmodal-badge"></span>
        </div>
        <div class="lmodal-right">
            <h2 id="lModalName"></h2>
            <p id="lModalDesc"></p>
            <div class="lmodal-stats">
                <div class="lmodal-stat">
                    <strong id="lModalExp"></strong>
                    <span>سال تجربه</span>
                </div>
                <div class="lmodal-stat-divider"></div>
                <div class="lmodal-stat">
                    <strong id="lModalLang"></strong>
                    <span>زبان تدریس</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Departments/language.js"></script>
}