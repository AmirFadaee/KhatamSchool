@{
    ViewData["Title"] = "بخش مشاوره";
}

@section Styles{
    <link rel="stylesheet"
          href="~/css/Departments/counseling.css" />
}

<section class="counsel-hero">
    <div class="counsel-hero-bg"></div>
    <div class="counsel-orb counsel-orb-1"></div>
    <div class="counsel-orb counsel-orb-2"></div>
    <div class="container text-center">
        <div class="counsel-hero-content">
            <span class="counsel-badge" data-aos="fade-down">Counseling Department</span>
            <h1 data-aos="fade-up" data-aos-delay="100">بخش مشاوره و راهنمایی</h1>
            <p data-aos="fade-up" data-aos-delay="200">همراه دانش‌آموزان در هر قدم از مسیر رشد</p>
            <div class="counsel-hero-actions" data-aos="fade-up" data-aos-delay="300">
                <a href="#ticket" class="counsel-cta-btn">
                    <span>ارسال تیکت به مشاور</span>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M5 12h14M12 5l7 7-7 7" />
                    </svg>
                </a>
                <a href="#counselors" class="counsel-outline-btn">آشنایی با مشاور</a>
            </div>
        </div>
    </div>
</section>

<section class="counsel-services">
    <div class="container">
        <div class="counsel-section-header" data-aos="fade-up">
            <span class="counsel-tag">خدمات ما</span>
            <h2>حوزه‌های مشاوره</h2>
        </div>
        <div class="counsel-services-grid">
            <div class="counsel-service-card" data-aos="fade-up" data-aos-delay="100">
                <div class="cs-icon">📚</div>
                <h3>مشاوره تحصیلی</h3>
                <p>برنامه‌ریزی درسی و راهنمایی در انتخاب رشته</p>
            </div>
            <div class="counsel-service-card" data-aos="fade-up" data-aos-delay="200">
                <div class="cs-icon">💚</div>
                <h3>مشاوره روانشناختی</h3>
                <p>حمایت عاطفی و تقویت سلامت روان دانش‌آموزان</p>
            </div>
            <div class="counsel-service-card" data-aos="fade-up" data-aos-delay="300">
                <div class="cs-icon">👨‍👩‍👧</div>
                <h3>مشاوره خانواده</h3>
                <p>ارتباط مؤثر بین والدین و مدرسه</p>
            </div>
            <div class="counsel-service-card" data-aos="fade-up" data-aos-delay="400">
                <div class="cs-icon">🎯</div>
                <h3>مشاوره شغلی</h3>
                <p>کشف استعداد و مسیر آینده دانش‌آموزان</p>
            </div>
        </div>
    </div>
</section>

<section class="counsel-team" id="counselors">
    <div class="container">
        <div class="counsel-section-header" data-aos="fade-up">
            <span class="counsel-tag">مشاور و روانشناس</span>
            <h2>مشاور ما</h2>
        </div>
        <div class="row justify-content-center">
            <div class="col-lg-4 col-md-6" data-aos="fade-up">
                <div class="counsel-card"
                     data-name="آقای علی صداقتی نیا"
                     data-role="مشاور و روانشناس"
                     data-desc="بیش از 5 سال سابقه و با مدرک کارشناسی ارشد"
                     data-exp="5+"
                     data-field="مشاور و روانشناس"
                     data-img="/images/Counseling/ChatGPT Image ۲۷ تیر ۱۴۰۵، ۲۳_۲۱_۰۶.webp">
                    <div class="counsel-card-glow"></div>
                    <div class="counsel-card-img">
                        <img src="~/images/Counseling/ChatGPT Image ۲۷ تیر ۱۴۰۵، ۲۳_۲۱_۰۶.webp" alt="مشاور" />
                        <div class="counsel-img-ring"></div>
                    </div>
                    <div class="counsel-card-info">
                        <h4>آقای علی صداقتی نیا</h4>
                        <span>مشاور و روانشناس</span>
                        <button class="counsel-profile-btn">مشاهده پروفایل</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="ticket-section" id="ticket">
    <div class="container">
        <div class="ticket-wrapper" data-aos="fade-up">
            <div class="ticket-left">
                <span class="counsel-tag">ارتباط مستقیم</span>
                <h2>ارسال تیکت به مشاور</h2>
                <p>والدین گرامی می‌توانند سوالات و نگرانی‌های خود را از طریق این فرم مستقیماً به مشاوران مدرسه ارسال کنند.</p>
                <div class="ticket-features">
                    <div class="ticket-feature">
                        <div class="tf-icon">⚡</div>
                        <div>
                            <strong>پاسخ سریع</strong>
                            <span>حداکثر ۲۴ ساعت</span>
                        </div>
                    </div>
                    <div class="ticket-feature">
                        <div class="tf-icon">🔒</div>
                        <div>
                            <strong>کاملاً محرمانه</strong>
                            <span>اطلاعات شما محفوظ است</span>
                        </div>
                    </div>
                    <div class="ticket-feature">
                        <div class="tf-icon">👤</div>
                        <div>
                            <strong>مشاور اختصاصی</strong>
                            <span>انتخاب مشاور دلخواه</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="ticket-right">
                <div class="ticket-form-card">
                    <div class="ticket-form-header">
                        <h3>فرم ارسال تیکت</h3>
                        <span>همه فیلدها الزامی است</span>
                    </div>
                    <div class="ticket-form">
                        <div class="tf-group">
                            <label>نام و نام خانوادگی</label>
                            <input type="text" id="ticketName" placeholder="نام شما" />
                        </div>
                        <div class="tf-group">
                            <label>نام دانش‌آموز</label>
                            <input type="text" id="ticketStudent" placeholder="نام فرزند شما" />
                        </div>
                        <div class="tf-group">
                            <label>شماره تماس</label>
                            <input type="tel" id="ticketPhone" placeholder="۰۹۱۲۰۰۰۰۰۰۰" />
                        </div>
                        <div class="tf-group">
                            <label>انتخاب مشاور</label>
                            <select id="ticketCounselor">
                                <option value="">انتخاب کنید</option>
                                <option value="1">مشاور تحصیلی</option>
                                <option value="2">مشاور روانشناختی</option>
                                <option value="3">مشاور خانواده</option>
                            </select>
                        </div>
                        <div class="tf-group tf-full">
                            <label>موضوع</label>
                            <input type="text" id="ticketSubject" placeholder="موضوع پیام خود را بنویسید" />
                        </div>
                        <div class="tf-group tf-full">
                            <label>شرح مشکل</label>
                            <textarea id="ticketMessage" rows="4" placeholder="توضیحات کامل را اینجا بنویسید..."></textarea>
                        </div>
                        <button class="ticket-submit-btn" id="ticketSubmit">
                            <span>ارسال تیکت</span>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M22 2L11 13M22 2L15 22l-4-9-9-4 20-7z" />
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="counsel-modal">
    <div class="counsel-backdrop"></div>
    <div class="counsel-modal-content">
        <button class="counsel-close-modal">×</button>
        <div class="cmodal-left">
            <div class="cmodal-img-wrapper">
                <img id="cModalImg" src="" alt="" />
                <div class="cmodal-img-ring"></div>
            </div>
            <span id="cModalBadge" class="cmodal-badge"></span>
        </div>
        <div class="cmodal-right">
            <h2 id="cModalName"></h2>
            <p id="cModalDesc"></p>
            <div class="cmodal-stats">
                <div class="cmodal-stat">
                    <strong id="cModalExp"></strong>
                    <span>سال تجربه</span>
                </div>
                <div class="cmodal-stat-divider"></div>
                <div class="cmodal-stat">
                    <strong id="cModalField"></strong>
                    <span>حوزه تخصصی</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="ticket-success-toast" id="ticketToast">
    <div class="toast-icon">✓</div>
    <div class="toast-text">
        <strong>تیکت شما ارسال شد</strong>
        <span>در اسرع وقت پاسخ داده می‌شود</span>
    </div>
</div>

@section Scripts {
    <script src="~/js/Departments/counseling.js"></script>
}