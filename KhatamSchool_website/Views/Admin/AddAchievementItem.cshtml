@using KhatamSchool_Application.ViewModels
@model AddAchievementItemPageViewModel

@{
    ViewData["Title"] = "افزودن دستاورد";
}
<section class="admin-form-page">
    <div class="admin-form-bg"></div>
    <div class="container">
        <div class="admin-form-header" data-aos="fade-down">
            <a href="/Admin/Dashboard" class="admin-back-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 12H5M12 19l-7-7 7-7" />
                </svg>
                بازگشت
            </a>
            <div>
                <span class="admin-badge">افتخارات</span>
                <h1>افزودن افتخارات و دستاورد ها</h1>
            </div>
        </div>

        <div class="admin-form-wrapper" data-aos="fade-up">

            <div class="admin-form-card">

                <div class="afc-header">
                    <div class="afc-icon">🏆</div>

                    <div>
                        <h3>ثبت دستاورد جدید</h3>
                        <span>تمام فیلدهای ستاره‌دار الزامی هستند</span>
                    </div>

                </div>

                <div class="admin-form">

                    <!-- Upload -->

                    <div class="admin-upload-area" id="achievementUploadArea">

                        <input type="file"
                               id="achievementImage"
                               accept="image/*"
                               style="display:none" />

                        <div class="upload-preview" id="achievementPreview">

                            <div class="upload-placeholder">

                                <span class="upload-icon">📷</span>

                                <p>کلیک کنید یا تصویر را اینجا رها کنید</p>

                                <span>PNG ، JPG تا 5MB</span>

                            </div>

                        </div>

                    </div>

                    <!-- Title -->

                    <div class="af-row">

                        <div class="af-group af-full">

                            <label>

                                عنوان

                                <span class="required">*</span>

                            </label>

                            <input id="aTitle"
                                   type="text"
                                   placeholder="عنوان دستاورد" />

                        </div>

                    </div>

                    <!-- Description -->

                    <div class="af-row">

                        <div class="af-group af-full">

                            <label>

                                توضیحات

                            </label>

                            <textarea id="aDescription"
                                      rows="5"
                                      placeholder="توضیحات دستاورد"></textarea>

                        </div>

                    </div>

                    <!-- Categories -->

                    <div class="af-row">

                        <div class="af-group af-full">

                            <label>

                                دسته بندی

                                <span class="required">*</span>

                            </label>

                            <div class="achievement-category-grid">

                                @foreach (var item in Model.Categories)
                                {
                                    <label class="achievement-category-card">

                                        <input type="radio"
                                               name="achievementCategory"
                                               value="@item.Id" />

                                        <div class="acc-icon">

                                            <i class="fa-solid @(item.IconClass ?? "fa-star")"></i>

                                        </div>

                                        <span>

                                            @item.Title

                                        </span>

                                    </label>
                                }

                            </div>

                        </div>

                    </div>

                    <!-- Order -->

                    <div class="af-row">

                        <div class="af-group">

                            <label>

                                ترتیب نمایش

                            </label>

                            <input id="aDisplayOrder"
                                   type="number"
                                   value="0" />

                        </div>

                        <div class="af-group">

                            <label>

                                وضعیت

                            </label>

                            <div class="af-toggle">

                                <input id="aIsActive"
                                       type="checkbox"
                                       checked />

                                <label class="toggle-label"
                                       for="aIsActive">

                                    فعال

                                </label>

                            </div>

                        </div>

                    </div>

                    <!-- Buttons -->

                    <div class="af-actions">

                        <button id="achievementSubmit"
                                class="af-submit-btn">

                            <span>

                                ذخیره دستاورد

                            </span>

                        </button>

                        <a href="/Admin/Dashboard"
                           class="af-cancel-btn">

                            انصراف

                        </a>

                    </div>

                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {

    <script src="~/js/Admin/addAchievementItem.js"></script>

}