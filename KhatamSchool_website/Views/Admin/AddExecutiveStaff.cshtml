@{
    ViewData["Title"] = "افزودن کادر اجرایی";
}

<section class="admin-form-page">
    <div class="admin-form-bg"></div>
    <div class="container">
        <div class="admin-form-header" data-aos="fade-down">
            <a href="/Admin/Dashboard" class="admin-back-btn">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M19 12H5M12 19l-7-7 7-7" />
                </svg>
                بازگشت
            </a>
            <div>
                <span class="admin-badge">کادر اجرایی</span>
                <h1>افزودن کادر اجرایی جدید</h1>
            </div>
        </div>

        <div class="admin-form-wrapper" data-aos="fade-up">
            <div class="admin-form-card">
                <div class="afc-header">
                    <div class="afc-icon">👔</div>
                    <div>
                        <h3>اطلاعات کادر اجرایی</h3>
                        <span>تمام فیلدهای ستاره‌دار الزامی هستند</span>
                    </div>
                </div>

                <div class="admin-form" id="executiveForm">

                    <div class="admin-upload-area" id="executiveUploadArea">
                        <input type="file" id="executiveImage" accept="image/*" style="display:none" />
                        <div class="upload-preview" id="executivePreview">
                            <div class="upload-placeholder">
                                <span class="upload-icon">📷</span>
                                <p>کلیک کنید یا عکس را اینجا بکشید</p>
                                <span>PNG، JPG تا ۵ مگابایت</span>
                            </div>
                        </div>
                    </div>

                    <div class="af-row">
                        <div class="af-group">
                            <label>نام <span class="required">*</span></label>
                            <input type="text" id="eFirstName" placeholder="نام" />
                        </div>
                        <div class="af-group">
                            <label>نام خانوادگی <span class="required">*</span></label>
                            <input type="text" id="eLastName" placeholder="نام خانوادگی" />
                        </div>
                    </div>

                    <div class="af-row">
                        <div class="af-group">
                            <label>کد پرسنلی <span class="required">*</span></label>
                            <input type="text" id="ePersonnelCode" placeholder="مثلاً E-1001" />
                        </div>
                        <div class="af-group">
                            <label>سمت <span class="required">*</span></label>
                            <select id="eRole">
                                <option value="">انتخاب کنید</option>
                                <option value="1">مدیر</option>
                                <option value="2">معاون آموزشی</option>
                                <option value="3">معاون اجرایی</option>
                                <option value="4">معاون پرورشی</option>
                                <option value="5">مسئول دفتر</option>
                                <option value="6">سایر</option>
                            </select>
                        </div>
                    </div>

                    <div class="af-row">
                        <div class="af-group af-full">
                            <label>عنوان سمت سفارشی</label>
                            <input type="text" id="eCustomRole" placeholder="اگه سمت خاصی دارن اینجا بنویسید" />
                        </div>
                    </div>

                    <div class="af-row">
                        <div class="af-group">
                            <label>حوزه تخصصی</label>
                            <input type="text" id="eExpertiseField" placeholder="مثلاً مدیریت آموزشی" />
                        </div>
                        <div class="af-group">
                            <label>سال‌های تجربه</label>
                            <input type="number" id="eExperience" placeholder="مثلاً ۱۵" min="0" max="50" />
                        </div>
                    </div>

                    <div class="af-row">
                        <div class="af-group">
                            <label>تاریخ استخدام <span class="required">*</span></label>
                            <input type="date" id="eHireDate" />
                        </div>
                        <div class="af-group">
                            <label>ترتیب نمایش</label>
                            <input type="number" id="eDisplayOrder" placeholder="۰" min="0" />
                        </div>
                    </div>

                    <div class="af-row">
                        <div class="af-group af-full">
                            <label>بیوگرافی</label>
                            <textarea id="eBio" rows="4" placeholder="توضیحات کوتاه..."></textarea>
                        </div>
                    </div>

                    <div class="af-row">
                        <div class="af-group">
                            <label>وضعیت</label>
                            <div class="af-toggle">
                                <input type="checkbox" id="eIsActive" checked />
                                <label for="eIsActive" class="toggle-label">فعال</label>
                            </div>
                        </div>
                    </div>

                    <div class="af-actions">
                        <button class="af-submit-btn" id="executiveSubmit">
                            <span>ذخیره کادر اجرایی</span>
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" />
                                <path d="M17 21v-8H7v8M7 3v5h8" />
                            </svg>
                        </button>
                        <a href="/Admin/Dashboard" class="af-cancel-btn">انصراف</a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/Admin/addExecutiveStaff.js"></script>
}