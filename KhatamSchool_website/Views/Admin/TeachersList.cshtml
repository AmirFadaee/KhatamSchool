@using KhatamSchool_Application.ViewModels
@model IEnumerable<TeacherListViewModel>
@{
    ViewData["Title"] = "لیست معلمان";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Admin/List.css" />
}

<section class="admin-list-page">
    <div class="admin-list-bg"></div>
    <div class="container">

        <div class="admin-list-header" data-aos="fade-down">
            <div class="alh-right">
                <a href="/Admin/Dashboard" class="admin-back-btn">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 12H5M12 19l-7-7 7-7" />
                    </svg>
                    بازگشت
                </a>
                <div>
                    <span class="admin-badge">کادر آموزشی</span>
                    <h1>لیست معلمان</h1>
                    <p>@Model.Count() معلم ثبت شده</p>
                </div>
            </div>
            <a href="/Admin/AddTeacher" class="al-add-btn">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 5v14M5 12h14" />
                </svg>
                افزودن معلم
            </a>
        </div>

        <div class="al-filters" data-aos="fade-up">
            <div class="al-search">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8" />
                    <path d="m21 21-4.35-4.35" />
                </svg>
                <input type="text" id="searchInput" placeholder="جستجو بر اساس نام یا کد پرسنلی..." />
            </div>
            <div class="al-filter-btns">
                <button class="al-filter-btn active" data-filter="all">همه</button>
                <button class="al-filter-btn" data-filter="active">فعال</button>
                <button class="al-filter-btn" data-filter="inactive">غیرفعال</button>
            </div>
        </div>

        <div class="al-table-wrapper" data-aos="fade-up" data-aos-delay="100">
            <table class="al-table" id="teachersTable">
                <thead>
                    <tr>
                        <th>معلم</th>
                        <th>کد پرسنلی</th>
                        <th>تخصص</th>
                        <th>تجربه</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var teacher in Model)
                    {
                        <tr class="al-row"
                            data-status="@(teacher.IsActive ? "active" : "inactive")"
                            data-name="@teacher.FullName"
                            data-code="@teacher.PersonnelCode">
                            <td>
                                <div class="al-person">
                                    <div class="al-avatar">
                                        @if (!string.IsNullOrEmpty(teacher.ProfileImagePath))
                                        {
                                            <img src="@teacher.ProfileImagePath" alt="@teacher.FullName" />
                                        }
                                        else
                                        {
                                            <span>@teacher.FullName.First()</span>
                                        }
                                    </div>
                                    <div class="al-person-info">
                                        <strong>@teacher.FullName</strong>
                                        <span>استخدام @teacher.HireDate.Year</span>
                                    </div>
                                </div>
                            </td>
                            <td><span class="al-code">@teacher.PersonnelCode</span></td>
                            <td class="al-muted">@(teacher.Specialty ?? "—")</td>
                            <td class="al-muted">@(teacher.YearsOfExperience.HasValue ? $"{teacher.YearsOfExperience} سال" : "—")</td>
                            <td>
                                <span class="al-status @(teacher.IsActive ? "active" : "inactive")">
                                    @(teacher.IsActive ? "فعال" : "غیرفعال")
                                </span>
                            </td>
                            <td>
                                <div class="al-actions">
                                    <a href="/Admin/UpdateTeacher/@teacher.Id" class="al-action-btn edit" title="ویرایش">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <path d="M11 4H4a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2v-7" />
                                            <path d="M18.5 2.5a2.121 2.121 0 013 3L12 15l-4 1 1-4 9.5-9.5z" />
                                        </svg>
                                    </a>
                                    <button class="al-action-btn delete" title="حذف"
                                            data-id="@teacher.Id" data-name="@teacher.FullName">
                                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                            <polyline points="3 6 5 6 21 6" />
                                            <path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6" />
                                            <path d="M10 11v6M14 11v6" />
                                            <path d="M9 6V4a1 1 0 011-1h4a1 1 0 011 1v2" />
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="al-empty">
                    <span>📋</span>
                    <p>هیچ معلمی ثبت نشده</p>
                    <a href="/Admin/AddTeacher" class="al-add-btn">افزودن اولین معلم</a>
                </div>
            }
        </div>

    </div>
</section>

@section Scripts {
    <script src="~/js/Admin/teachersList.js"></script>
}