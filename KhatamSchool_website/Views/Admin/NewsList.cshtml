@using KhatamSchool_Application.ViewModels
@model IEnumerable<NewsListViewModel>

@{
    ViewData["Title"] = "لیست اخبار";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/Admin/List.css" />
}

<section class="admin-list-page">
    <div class="admin-list-bg"></div>
    <div class="container">

        <div class="admin-list-header" data-aos="fade-down">

            <div class="alh-right">

                <a href="/Admin/Dashboard" class="admin-back-btn">

                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M19 12H5M12 19l-7-7 7-7" />
                    </svg>

                    بازگشت

                </a>

                <div>

                    <span class="admin-badge">
                        اخبار مدرسه
                    </span>

                    <h1>
                        لیست اخبار
                    </h1>

                    <p>
                        @Model.Count() خبر ثبت شده
                    </p>

                </div>

            </div>

            <a href="/Admin/AddNews" class="al-add-btn">

                <svg width="18" height="18" viewBox="0 0 24 24"
                     fill="none" stroke="currentColor" stroke-width="2">

                    <path d="M12 5v14M5 12h14" />

                </svg>

                افزودن خبر

            </a>

        </div>

        <div class="al-filters" data-aos="fade-up">

            <div class="al-search">

                <svg width="16"
                     height="16"
                     viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">

                    <circle cx="11" cy="11" r="8" />

                    <path d="m21 21-4.35-4.35" />

                </svg>

                <input type="text"
                       id="searchInput"
                       placeholder="جستجو بر اساس عنوان خبر..." />

            </div>

            <div class="al-filter-btns">

                <button class="al-filter-btn active"
                        data-filter="all">

                    همه

                </button>

                <button class="al-filter-btn"
                        data-filter="published">

                    منتشر شده

                </button>

                <button class="al-filter-btn"
                        data-filter="draft">

                    پیش نویس

                </button>

                <button class="al-filter-btn"
                        data-filter="featured">

                    ویژه

                </button>

            </div>

        </div>

        <div class="al-table-wrapper"
             data-aos="fade-up"
             data-aos-delay="100">

            <table class="al-table"
                   id="newsTable">

                <thead>

                    <tr>

                        <th>خبر</th>

                        <th>تاریخ انتشار</th>

                        <th>بازدید</th>

                        <th>وضعیت</th>

                        <th>ویژه</th>

                        <th>عملیات</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var news in Model)
                    {
                        <tr class="al-row"
                            data-title="@news.Title.ToLower()"
                            data-status="@(news.IsPublished ? "published" : "draft")"
                            data-featured="@(news.IsFeatured ? "1" : "0")">

                            <td>

                                <div class="al-person">

                                    <div class="al-avatar">

                                        @if (!string.IsNullOrEmpty(news.CoverImage))
                                        {
                                            <img src="@news.CoverImage"
                                                 alt="@news.Title" />
                                        }
                                        else
                                        {
                                            <span>📰</span>
                                        }

                                    </div>

                                    <div class="al-person-info">

                                        <strong>

                                            @news.Title

                                        </strong>

                                        <span>

                                            @(news.Summary.Length > 70
                                                ? news.Summary.Substring(0, 70) + "..."
                                                : news.Summary)

                                        </span>

                                    </div>

                                </div>

                            </td>

                            <td>

                                <span class="al-muted">

                                    @(news.PublishedAt?.ToString("yyyy/MM/dd") ?? "---")

                                </span>

                            </td>

                            <td>

                                <span class="al-code">

                                    @news.ViewCount

                                </span>

                            </td>

                            <td>

                                @if (news.IsPublished)
                                {
                                    <span class="al-status active">

                                        منتشر شده

                                    </span>
                                }
                                else
                                {
                                    <span class="al-status inactive">

                                        پیش نویس

                                    </span>
                                }

                            </td>

                            <td>

                                @if (news.IsFeatured)
                                {
                                    <span class="al-role-badge al-role-2">

                                        ⭐ ویژه

                                    </span>
                                }
                                else
                                {
                                    <span class="al-muted">

                                        —

                                    </span>
                                }

                            </td>

                            <td>

                                <div class="al-actions">

                                    <a href="/Admin/EditNews/@news.Id"
                                       class="al-action-btn edit"
                                       title="ویرایش">

                                        <svg width="15"
                                             height="15"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2">

                                            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" />

                                            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" />

                                        </svg>

                                    </a>

                                    <button class="al-action-btn delete"
                                            data-id="@news.Id"
                                            data-title="@news.Title"
                                            title="حذف">

                                        <svg width="15"
                                             height="15"
                                             viewBox="0 0 24 24"
                                             fill="none"
                                             stroke="currentColor"
                                             stroke-width="2">

                                            <polyline points="3 6 5 6 21 6" />

                                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" />

                                            <path d="M10 11v6M14 11v6" />

                                            <path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2" />

                                        </svg>

                                    </button>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

            @if (!Model.Any())
            {
                <div class="al-empty">

                    <span>
                        📰
                    </span>

                    <p>

                        هنوز خبری ثبت نشده است.

                    </p>

                    <a href="/Admin/AddNews"
                       class="al-add-btn">

                        افزودن اولین خبر

                    </a>

                </div>
            }

        </div>
    </div>
</section>

@section Scripts
{
    <script src="~/js/Admin/newsList.js"></script>
}