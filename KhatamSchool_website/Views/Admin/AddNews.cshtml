@{
    ViewData["Title"] = "افزودن خبر";
}

<section class="admin-form-page">
    <div class="admin-form-bg"></div>
    <div class="container">
        <div class="admin-page">

            <div class="admin-form-wrapper" data-aos="fade-up">

                <div class="admin-form-card">

                    <div class="afc-header">
                        <div class="afc-icon">📰</div>

                        <div>
                            <h3>ثبت خبر جدید</h3>
                            <span>تمام فیلدهای ستاره‌دار الزامی هستند</span>
                        </div>

                    </div>

                    <div class="admin-form" id="newsForm">

                        <!-- Cover Image -->

                        <div class="admin-upload-area" id="newsUploadArea">

                            <input type="file"
                                   id="newsImage"
                                   accept="image/*"
                                   style="display:none" />

                            <div class="upload-preview" id="newsPreview">

                                <div class="upload-placeholder">

                                    <span class="upload-icon">🖼️</span>

                                    <p>کلیک کنید یا تصویر خبر را اینجا رها کنید</p>

                                    <span>PNG ، JPG تا ۵ مگابایت</span>

                                </div>

                            </div>

                        </div>

                        <!-- Title -->

                        <div class="af-row">

                            <div class="af-group af-full">

                                <label>
                                    عنوان خبر
                                    <span class="required">*</span>
                                </label>

                                <input type="text"
                                       id="nTitle"
                                       placeholder="عنوان خبر..." />

                            </div>

                        </div>

                        <!-- Summary -->

                        <div class="af-row">

                            <div class="af-group af-full">

                                <label>
                                    خلاصه خبر
                                    <span class="required">*</span>
                                </label>

                                <textarea id="nSummary"
                                          rows="3"
                                          placeholder="خلاصه کوتاهی از خبر..."></textarea>

                            </div>

                        </div>

                        <!-- Content -->

                        <div class="af-row">

                            <div class="af-group af-full">

                                <label>
                                    متن کامل خبر
                                    <span class="required">*</span>
                                </label>

                                <textarea id="nContent"
                                          rows="10"
                                          placeholder="متن کامل خبر..."></textarea>

                            </div>

                        </div>

                        <!-- Publish Date -->

                        <div class="af-row">

                            <div class="af-group">

                                <label>تاریخ انتشار</label>

                                <input type="datetime-local"
                                       id="nPublishedAt"
                                       value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />

                            </div>

                        </div>

                        <!-- Switches -->

                        <div class="af-row">

                            <div class="af-group">

                                <label>انتشار خبر</label>

                                <div class="af-toggle">

                                    <input type="checkbox"
                                           id="nIsPublished"
                                           checked />

                                    <label for="nIsPublished"
                                           class="toggle-label">

                                        منتشر شود

                                    </label>

                                </div>

                            </div>

                            <div class="af-group">

                                <label>خبر ویژه</label>

                                <div class="af-toggle">

                                    <input type="checkbox"
                                           id="nIsFeatured" />

                                    <label for="nIsFeatured"
                                           class="toggle-label">

                                        نمایش به عنوان خبر ویژه

                                    </label>

                                </div>

                            </div>

                        </div>

                        <!-- Buttons -->

                        <div class="af-actions">

                            <button class="af-submit-btn"
                                    id="newsSubmit">

                                <span>

                                    ذخیره خبر

                                </span>

                                <svg width="18"
                                     height="18"
                                     viewBox="0 0 24 24"
                                     fill="none"
                                     stroke="currentColor"
                                     stroke-width="2">

                                    <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />

                                    <path d="M17 21v-8H7v8M7 3v5h8" />

                                </svg>

                            </button>

                            <a href="/Admin/Dashboard"
                               class="af-cancel-btn">

                                انصراف

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    </div>
</section>

@section Scripts {

    <script src="~/js/Admin/AddNews.js"></script>

}