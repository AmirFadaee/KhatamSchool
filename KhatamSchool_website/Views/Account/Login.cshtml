@{
    ViewData["Title"] = "ورود";
    Layout = null;
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ورود - مدرسه خاتم</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css">
    <link rel="stylesheet" href="~/css/base/variables.css">
    <link rel="stylesheet" href="~/css/base/typography.css">
    <link rel="stylesheet" href="~/css/Account/auth.css">
</head>
<body class="auth-body">

    <div class="auth-page">
        <div class="auth-blob auth-blob-1"></div>
        <div class="auth-blob auth-blob-2"></div>
        <div class="auth-grid-pattern"></div>

        <div class="auth-card" data-aos="fade-up">
            <div class="auth-card-header">
                <div class="auth-logo">
                    <i class="fa-solid fa-graduation-cap"></i>
                </div>
                <h1>ورود به حساب کاربری</h1>
                <p>خوش آمدید! اطلاعات ورود خود را وارد کنید</p>
            </div>

            <div class="auth-form" id="loginForm">
                <div class="auth-group">
                    <label>نام کاربری</label>
                    <div class="auth-input-wrapper">
                        <i class="fa-solid fa-at"></i>
                        <input type="text" id="loginUsername" placeholder="نام کاربری خود را وارد کنید" autocomplete="username" />
                    </div>
                </div>

                <div class="auth-group">
                    <label>رمز عبور</label>
                    <div class="auth-input-wrapper">
                        <i class="fa-solid fa-lock"></i>
                        <input type="password" id="loginPassword" placeholder="رمز عبور خود را وارد کنید" autocomplete="current-password" />
                    </div>
                </div>

                <button class="auth-submit-btn" id="loginSubmit">
                    <span>ورود</span>
                    <i class="fa-solid fa-arrow-left"></i>
                </button>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>
    <script src="~/js/Account/login.js"></script>
</body>
</html>